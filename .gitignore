# Keep generated model files out of git history by default.
# Use Git LFS or a release artifact if these need to be shared.
*.pt
*.pth
*.onnx
*.om

# Allow placeholder files and model documentation to be tracked.
!models/**/*.gitkeep
!models/**/文件夹说明.md
!atlas_deploy_powerline_yolov5s/models/**/*.gitkeep
!atlas_deploy_powerline_yolov5s/models/**/文件夹说明.md
